<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/SearchBarStyle_v2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/settingslib_materialColorSurfaceContainerHigh"
    app:cardCornerRadius="24dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:id="@+id/search_action_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:focusedByDefault="true"
        android:background="@drawable/search_bar_selected_background">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_homepage_search" />
        <TextView
            android:id="@+id/search_bar_title"
            style="@style/TextAppearance.SearchBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingEnd="8dp"
            android:textSize="15sp"
            android:text="@string/homepage_search"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
